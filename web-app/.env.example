# NestJS API. Server-side only — never prefix with NEXT_PUBLIC_.
# The browser talks to /api/bff/* on this origin.
API_BASE_URL=http://possystem.hrsystem.cloud/api/v1
# Local NestJS instead: API_BASE_URL=http://localhost:3000/api/v1

NEXT_PUBLIC_APP_NAME=Machinery
NEXT_PUBLIC_CLIENT_VERSION=1.0.0

SESSION_COOKIE_NAME=mch_session
SESSION_COOKIE_SECURE=false
