# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. The app refuses to boot if anything is missing
# or malformed — see src/config/env.validation.ts
#
# Wrap any value containing `#` in double quotes. dotenv treats an unquoted `#`
# as the start of a comment and silently truncates the value, which bites
# hardest on generated secrets and passwords.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=30000

# Comma-separated allowlist. Empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:3000

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=machinery
DB_SSL=false
# Only set to false for managed DBs whose CA cannot be pinned — disables MITM protection.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_SIZE=20

# --- proxy ---
# REQUIRED when running behind nginx/ALB/Cloudflare, otherwise every client shares the
# proxy's IP and the login lockout locks out whole populations. Use the number of proxy
# hops in front of the app (usually 1). Leave empty when exposed directly.
TRUST_PROXY=

# --- auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_a_32_char_minimum_secret_value
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- redis ---
# Optional locally (falls back to an in-process cache); REQUIRED in production.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
PERMISSION_CACHE_TTL_SECONDS=900

# --- storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=10
# Dedicated HMAC key for signed media URLs (min 32 chars). REQUIRED in production and
# must differ from JWT_ACCESS_SECRET. Generate with: openssl rand -hex 32
STORAGE_URL_SIGNING_SECRET=
# Hourly sweep that deletes unconfirmed, unattached media older than 24h. Defaults to on
# outside NODE_ENV=test; set to "false" to disable, "true" to force it on under test.
MEDIA_CLEANUP_ENABLED=

# --- client / business rules ---
# Dotted major.minor[.patch] (e.g. 2.1.0). Empty disables forced-upgrade checks entirely.
MIN_CLIENT_VERSION=
FINANCE_BACKDATE_LIMIT_DAYS=90
FINANCE_EDIT_WINDOW_DAYS=30
TRANSFER_CANCEL_WINDOW_MINUTES=60

# --- rate limiting / operations ---
# 300/min/user (sync-batch, media-presign, report-export get their own tighter ceilings).
# Empty/unset = on outside NODE_ENV=test, off under it; "true"/"false" forces either way.
THROTTLE_ENABLED=
# Bearer token GET /metrics requires. REQUIRED in production; open locally when empty.
METRICS_TOKEN=

# --- seeding (used by `npm run seed`) ---
SEED_DIRECTOR_PHONE=01000000000
SEED_DIRECTOR_NAME=مدير النظام
SEED_DIRECTOR_EMAIL=
# Required to create the bootstrap Director; the account must change it on first login.
SEED_DIRECTOR_PASSWORD=
