# Root-level ignores. `backend/api/.gitignore` and `mobile-app/.gitignore` already cover their
# own subtrees (node_modules, dist, .env*, Flutter build artifacts) — git applies nested
# .gitignore files automatically, so this file only needs what those two don't already handle.

.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Local dependencies, caches, and generated output
node_modules/
.gradle/
.gradle-home/
.dart_tool/
.pub-cache/
.local-flutter/
.local-config/
.fvm/flutter_sdk

# Local environment and signing credentials
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
local.properties
key.properties
*.jks
*.keystore
