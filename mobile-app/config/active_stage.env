# Manual build stage — edit this, then run:
#   ./scripts/run_flavor.sh
#   ./scripts/run_flavor.sh apk
#
# FLAVOR  → which Android/iOS flavor + config/*.env.json
#           development | staging | production
#
# MODE    → Flutter build mode
#           debug | profile | production
#           (production uses Flutter --release)

FLAVOR=development
MODE=debug
